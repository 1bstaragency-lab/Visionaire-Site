# ————————————————————————————————
# Supabase — lead capture + admin panel
# ————————————————————————————————
NEXT_PUBLIC_SUPABASE_URL=https://jtinuomalariwyktshou.supabase.co

# Publishable (anon) key — safe to expose, ships in the client bundle.
# Used by the public contact form to INSERT inquiries.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server-only, never prefixed with NEXT_PUBLIC_.
# Bypasses row-level security so /admin can read every inquiry.
# Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ————————————————————————————————
# Admin panel
# ————————————————————————————————
# Password for /admin. Use a long random string.
ADMIN_PASSWORD=

# ————————————————————————————————
# Scheduling (contact page booking)
# ————————————————————————————————
# Until NEXT_PUBLIC_CAL_LINK is set, the contact page falls back to the
# existing Calendly link, so booking keeps working either way.

# Your Cal booking path, e.g. "visionaire/30min"
NEXT_PUBLIC_CAL_LINK=

# Only needed for a SELF-HOSTED Cal.diy instance. Leave both blank to use
# Cal.com's hosted service.
# NEXT_PUBLIC_CAL_ORIGIN=https://cal.visionsaire.com
# NEXT_PUBLIC_CAL_EMBED_JS_URL=https://cal.visionsaire.com/embed/embed.js
